{
  "name": "bashroom",
  "version": "2.0.1",
  "description": "A filesystem for agents.",
  "type": "module",
  "bin": {
    "bashroom": "bin/bashroom.js"
  },
  "files": [
    "bin/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "og": "node scripts/render-og.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:room-text-workerd": "node scripts/room-text-probe/run.mjs",
    "webcheck": "node scripts/check-webui.mjs src/web-ui.ts /tmp/bashroom-web-ui.js && node --check /tmp/bashroom-web-ui.js && node scripts/check-collab-ui.mjs src/web-collab.ts src/index.ts",
    "smoke": "node bin/bashroom.js --help",
    "check": "npm run typecheck && npm test && npm run test:room-text-workerd && npm run webcheck && npm run smoke"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.12.3",
    "@codemirror/collab": "^6.1.1",
    "@codemirror/state": "^6.7.1",
    "@modelcontextprotocol/sdk": "1.26.0",
    "agents": "^0.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260617.1",
    "json-joy": "^18.28.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "4.102.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "fast-uri": "3.1.3",
    "ip-address": "10.2.0",
    "js-yaml": "4.3.0",
    "qs": "6.15.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdan/bashroom.git"
  },
  "homepage": "https://bashroom.sdan.io",
  "bugs": {
    "url": "https://github.com/sdan/bashroom/issues"
  },
  "keywords": [
    "mcp",
    "agents",
    "claude",
    "codex",
    "cloudflare-workers",
    "durable-objects",
    "markdown"
  ]
}
