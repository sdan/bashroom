# v1 -> v2 migration backups (private room contents).
# Kept locally as the rollback artifact; not for git history.
backup/

# Skills installed via `npx skills add` — vendor cache, not project source.
.agents/
skills-lock.json

# OG card: only the bundled PNG (assets/og.png) is committed — it's imported
# by the worker. The source of truth is ogSvg() in src/og.ts; any scratch SVG
# rendered alongside it (e.g. via curl) is regenerated, not tracked.
assets/og.svg

# Local working space — lesson scratch, experiments. Not project source.
scratch/

# Internal writeups not for the public repo.
docs/harness-vs-claude-code.md

# Usage/metrics operator tooling kept internal (admin-gated fan-out script
# + any local report output). The feature lives as a local-only patch in
# ~/.bashroom-metrics-patch, not in the public repo.
scripts/usage.ts
usage-report.*
benchmarks/room-text/node_modules/
