{
  "name": "bashroom-room-text-benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "npm run bench:synthetic && npm run bench:traces",
    "bench:synthetic": "node --expose-gc --import tsx benchmark.ts",
    "bench:traces": "node --expose-gc --import tsx trace-benchmark.ts",
    "bench:workerd": "node workerd-benchmark.mjs",
    "bench:liveblocks": "liveblocks dev --random-port --no-check --cmd \"node liveblocks-local.mjs\""
  },
  "dependencies": {
    "@codemirror/collab": "6.1.1",
    "@codemirror/state": "6.7.1",
    "@jsonjoy.com/json-pack": "18.28.0",
    "@liveblocks/client": "3.22.0",
    "@liveblocks/yjs": "3.22.0",
    "editing-traces": "https://github.com/streamich/editing-traces/archive/71c6d732956dbe08a490f8cd9764214bd3d4c9b7.tar.gz",
    "liveblocks": "1.6.2",
    "tsx": "4.20.6",
    "ws": "8.21.0",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "json-joy": "^18.28.0"
  }
}
